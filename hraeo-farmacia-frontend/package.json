{
  "name": "hraeo-farmacia-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:red": "ng serve --host 0.0.0.0",
    "start:celular": "ng serve --host 0.0.0.0 --ssl",
    "start:iphone": "ng serve --host 0.0.0.0 --ssl --ssl-cert certs/haero.pem --ssl-key certs/haero-key.pem",
    "start:pc-http": "ng serve --host 0.0.0.0 --port 4200",
    "start:iphone-https": "ng serve --host 0.0.0.0 --port 4201 --ssl --ssl-cert certs/haero.pem --ssl-key certs/haero-key.pem",
    "start:ambos": "concurrently -n PC-HTTP,IPHONE-HTTPS -c cyan,magenta \"npm:start:pc-http\" \"npm:start:iphone-https\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
