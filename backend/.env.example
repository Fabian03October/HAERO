# Copia este archivo como .env (nunca subas el .env a git) y llena los valores.

# Base de datos de HAERO (SQL Server).
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=farmacia;encrypt=true;trustServerCertificate=true
DB_USERNAME=farmacia_app
DB_PASSWORD=

# Perfil del servidor del hospital: Hibernate no cambia tablas y no se registran consultas.
SPRING_PROFILES_ACTIVE=prod

# Clave para firmar las sesiones (al menos 32 caracteres). Si se deja vacía, se crea una
# al azar en ~/.hraeo/jwt-secret y se reutiliza en cada arranque.
JWT_SECRET=

# Direcciones desde las que se abre el frontend, separadas por coma. Si nginx sirve el
# frontend y reenvía /api en la misma dirección, basta con esa dirección.
CORS_ORIGENES=http://localhost:4200

# true: entrar con una cuenta cierra sus otras sesiones (recomendado: una cuenta por persona).
SEGURIDAD_SESION_UNICA=true

# Intelisis (solo lectura).
INTELISIS_HABILITADO=true
INTELISIS_URL=
INTELISIS_USUARIO=
INTELISIS_PASSWORD=
# Intelisis usa SQL Server 2012 con TLS 1.0.
INTELISIS_TLSHEREDADO=true

# Solo para recuperar al administrador si olvidó su contraseña: se pone una contraseña
# temporal, se reinicia el backend, el administrador entra y la cambia, y se BORRA esta línea.
# ADMIN_RESTABLECER_CONTRASENA=
